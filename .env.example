# evaluator-cog — the names this cog reads. Names only: the values live in
# Doppler (evaluator-cog / dev locally, prd deployed). Run under
# `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required in Doppler's dev config, and
# `uv run check-doppler-keys` checks dev holds every one. Commented names
# are optional: the code has a default, or only production reads them. In
# production the Lambda gets these from SSM (secrets) and its function
# environment, both declared in mini-app-polis/infra. How and when the
# deployed worker re-reads them: docs/CONFIGURATION.md.

# API key for Anthropic Claude. Only mode='llm' spends it; the release path
# is deterministic and costs no tokens.
ANTHROPIC_API_KEY=

# Claude model to use for evaluation. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=

# GitHub personal access token with read access to mini-app-polis repos.
# Required for the conformance flow to download private repos as zipballs.
GITHUB_TOKEN=

# Where the standards catalog is read. Defaults to the production API's
# catalog endpoint in every environment: catalogs are published only from
# ecosystem-standards' release on main. Override for a local API or a
# pinned version.
# ECOSYSTEM_STANDARDS_CATALOG_URL=

# Timeouts, in seconds: downloading a repository (default 60), a git
# command (10), an HTTP call to the API or the catalog (20), and one model
# call (120).
# EVALUATOR_CLONE_TIMEOUT_SECONDS=
# EVALUATOR_GIT_TIMEOUT_SECONDS=
# EVALUATOR_HTTP_TIMEOUT_SECONDS=
# EVALUATOR_LLM_TIMEOUT_SECONDS=

# external tooling: read by miniapppolis-common-utils' KaianoApiClient.
# Base URL of api-kaianolevine-com. Production reads the unsuffixed name;
# every other environment reads KAIANO_API_BASE_URL_DEV, with no fallback
# between them — an unset dev URL in dev is an error, not a quiet redirect
# to production.
KAIANO_API_BASE_URL_DEV=
# KAIANO_API_BASE_URL=

# external tooling: read by miniapppolis-common-utils' KaianoApiClient.
# This cog's own named API key, matching the machine name it declares to
# KaianoApiClient. Unset, the shared client falls back to the generic
# KAIANO_API_KEY; with neither, every call to the API fails, and a wrong key
# is a 401. See ecosystem-standards CD-019.
EVALUATOR_COG_API_KEY=

# external tooling: read by miniapppolis-common-utils' init_sentry.
# Sentry DSN for error tracking. Read once per cold start, so a change needs
# a cold start.
# SENTRY_DSN_COGS=

# external tooling: read by miniapppolis-common-utils' logger.
# Log level for the fleet's logger. Defaults to INFO. Re-applied at every
# invocation; an unrecognised value is logged and ignored.
# LOGGING_LEVEL=

# external tooling: read by miniapppolis-common-utils' environment module.
# Which environment this process is in. Doppler sets it per config
# (development in dev). On Lambda, the infra module sets it to "production".
# Unset resolves to local.
# ENVIRONMENT=

# Not here any more, and worth saying why rather than leaving a gap:
#
# AWS_REGION — nothing reads it. The container's boto3 client needed a
# region; the handler creates no client, and Lambda supplies the region
# to anything that does.
#
# EVALUATION_QUEUE_URL — the worker does not read a queue. The Lambda
# event source mapping receives and invokes; the handler is handed a
# message and never asks for one. The API holds the queue URL, because
# the API is what sends.
#
# EVALUATION_QUEUE_CONSUMER_KEY_ID / _SECRET — there is no key. The
# Railway container needed one because a container cannot assume a role;
# the Lambda uses its execution role, which carries exactly the same
# receive-and-delete permissions and expires on its own. The IAM user and
# its key were deleted with the cutover.
#
# EVALUATOR_INVOKE_SECRET — there is no inbound HTTP. The adapter that
# served POST /invoke behind a shared secret was replaced by the queue.
#
# PREFECT_API_KEY / PREFECT_API_URL — for the retired Prefect; nothing
# here reads them (ADR-0004).
#
# HEALTHCHECKS_URL_EVALUATOR — there is no Healthchecks.io check for the
# evaluator; the ping code that read it was removed.
