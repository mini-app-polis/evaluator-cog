#!/usr/bin/env python3
"""Run terraform in this directory with the cog's secrets read from Doppler.

    ./tf plan -out tfplan
    ./tf apply tfplan

Why this exists: the secrets live in Doppler, and terraform.tfvars is not
where they belong. State records every attribute Terraform sets, so a
secret passed through a file ends up in two plaintext files instead of
one — and the file is the one a `.gitignore` is the only thing keeping
out of the repository (SEC-008). Reading them from `doppler secrets
download` straight into terraform's environment means they never touch
the clipboard, the shell history, or any file but the state and plan
Terraform writes itself.

tfvars keeps what it is for: the non-secret settings — kaiano_api_base_url,
alert_email, create_github_oidc_provider.

One-time per machine, in this directory:

    doppler setup --project <evaluator-cog project> --config prd

(or set DOPPLER_PROJECT / DOPPLER_CONFIG for a single run). Nothing secret
is printed: only which names were found, and how much of Lambda's 4 KB
environment the whole set uses.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

#: Doppler name -> required. The Terraform variable is the name lowercased,
#: which is what makes the TF_VAR_ convention line up without a mapping.
SECRETS = {
    "EVALUATOR_COG_API_KEY": True,
    "GITHUB_TOKEN": True,
    "ANTHROPIC_API_KEY": False,
    "SENTRY_DSN": False,
}

#: Doppler names accepted for a secret under its older spelling. The fleet
#: moved to SENTRY_DSN; this cog's Lambda still reads SENTRY_DSN_EVALUATOR
#: (see worker.tf), so the Doppler side may be under either name. The
#: canonical name wins when both are set.
ALIASES = {"SENTRY_DSN": ("SENTRY_DSN_EVALUATOR",)}

#: The worker's environment that does not come from Doppler, as worker.tf
#: sets it, for the size check.
FIXED_ENV = {
    "KAIANO_API_BASE_URL": "https://api.kaianolevine.com/",
    "ENVIRONMENT": "production",
}

#: Lambda's cap on the whole environment, keys included.
LAMBDA_ENV_LIMIT = 4096


def fail(message: str) -> None:
    print(f"tf: {message}", file=sys.stderr)
    sys.exit(1)


def doppler_secrets() -> dict[str, str]:
    cmd = ["doppler", "secrets", "download", "--no-file", "--format", "json"]
    if os.environ.get("DOPPLER_PROJECT"):
        cmd += ["--project", os.environ["DOPPLER_PROJECT"]]
    if os.environ.get("DOPPLER_CONFIG"):
        cmd += ["--config", os.environ["DOPPLER_CONFIG"]]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    except FileNotFoundError:
        fail("the doppler CLI is not installed")
    except subprocess.CalledProcessError as exc:
        fail(
            "doppler could not read secrets. Run once in this directory:\n"
            "    doppler setup --project <evaluator-cog project> --config prd\n"
            f"doppler said: {exc.stderr.strip()}"
        )
    return json.loads(out)


def lookup(secrets: dict[str, str], name: str) -> str:
    """The secret under its canonical name, or under an accepted older one."""
    value = secrets.get(name, "")
    if value:
        return value
    for alias in ALIASES.get(name, ()):
        if secrets.get(alias):
            print(f"tf: {name:<24} found as {alias}")
            return secrets[alias]
    return ""


def overridden_in_tfvars() -> list[str]:
    """Secrets also set in terraform.tfvars, which would silently win."""
    tfvars = HERE / "terraform.tfvars"
    if not tfvars.exists():
        return []
    declared = set(re.findall(r"^\s*(\w+)\s*=", tfvars.read_text(), re.M))
    return sorted(name.lower() for name in SECRETS if name.lower() in declared)


def main() -> None:
    if len(sys.argv) < 2:
        fail("usage: ./tf plan -out tfplan   |   ./tf apply tfplan")

    clashes = overridden_in_tfvars()
    if clashes:
        fail(
            "terraform.tfvars sets " + ", ".join(clashes) + ". Remove them: "
            "tfvars wins over the environment, so they would override "
            "Doppler — and a secret in tfvars is the arrangement this "
            "wrapper exists to end. Confirm Doppler holds each one first."
        )

    secrets = doppler_secrets()
    env = dict(os.environ)
    env.setdefault("AWS_PROFILE", "miniapppolis")

    env_bytes = sum(len(k) + len(v) for k, v in FIXED_ENV.items())
    for name, required in SECRETS.items():
        value = lookup(secrets, name)
        env_bytes += len(name)
        if not value:
            if required:
                fail(f"Doppler has no {name}")
            print(
                f"tf: {name:<24} not in Doppler (optional; the variable's "
                f"default applies)"
            )
            continue
        print(f"tf: {name:<24} ok")
        env[f"TF_VAR_{name.lower()}"] = value
        env_bytes += len(value)

    # Lambda refuses the whole apply past 4 KB, with an error that names the
    # limit and not the variable. Saying so first, with the number, is
    # cheaper than reading that error.
    print(f"tf: Lambda environment ~{env_bytes} of {LAMBDA_ENV_LIMIT} bytes")
    if env_bytes > LAMBDA_ENV_LIMIT:
        fail("the worker's environment would exceed Lambda's 4 KB cap.")

    args = sys.argv[1:]
    # Never prompt: a prompt means a variable did not arrive, and typing a
    # secret into it is how this goes wrong.
    if (
        args[0] in {"plan", "apply", "destroy", "refresh", "import"}
        and "-input=false" not in args
    ):
        args.insert(1, "-input=false")
    # exec replaces this process, so anything still buffered is lost.
    sys.stdout.flush()
    os.execvpe("terraform", ["terraform", *args], env)


if __name__ == "__main__":
    main()
